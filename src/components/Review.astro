---
import QuoteLeft from "../assets/icons/quote-left.svg"
import QuoteRight from "../assets/icons/quote-right.svg"

type Review = {
	review: {
		reviewer: string
		publisher: string
		comment: string
		link: string
	}
	show: {
		title: string
		role: string
		company: string
		when: string
		link: string
	}
}
const { review, show } = Astro.props
---

<div class="snap-center space-y-4 bg-neutral-900 md:space-y-8 lg:space-y-12">
	<div>
		<QuoteLeft class="size-16 fill-neutral-600 pl-4 md:size-24 md:pl-8 lg:size-32" />
		<blockquote class="mx-auto w-4/5 font-medium" cite={review.link}>
			{review.comment}
			<span class="font-normal text-neutral-300"
				>{review.reviewer}
				<cite class="">
					- <a class="underline-offset-4 hover:underline" href={review.link}>{review.publisher}</a
					></cite
				></span
			>
		</blockquote>
		<QuoteRight class="ml-auto size-16 fill-neutral-600 pr-4 md:size-24 md:pr-8 lg:size-32" />
	</div>
	<div class="mx-auto flex flex-col items-end px-4 text-sm md:px-8">
		<div class="text-right">{show.role}</div>
		<div class="text-right font-semibold">{show.title}</div>
		<div class="">
			<a class="underline underline-offset-4" href={show.link}>{show.company}</a>
			<span>, {show.when}</span>
		</div>
	</div>
</div>
